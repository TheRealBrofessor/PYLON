name: ${COMPOSE_PROJECT_NAME}

services:
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:${STACK_VERSION}
    restart: unless-stopped

    environment:
      node.name: pylon-es01
      cluster.name: ${CLUSTER_NAME}
      discovery.type: single-node

      ELASTIC_PASSWORD: ${ELASTIC_PASSWORD}
      ES_JAVA_OPTS: ${ES_JAVA_OPTS}

      xpack.security.enabled: "true"
      xpack.security.enrollment.enabled: "true"

      # Initial localhost-only lab deployment.
      # TLS will be added before exposing services beyond this VM.
      xpack.security.http.ssl.enabled: "false"
      xpack.security.transport.ssl.enabled: "false"

    ports:
      - "${ES_PORT}:9200"

    volumes:
      - type: bind
        source: ./services/elasticsearch/data
        target: /usr/share/elasticsearch/data

    networks:
      - pylon

    mem_limit: 12g

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "curl -fsS -u elastic:$${ELASTIC_PASSWORD} http://localhost:9200/_cluster/health >/dev/null || exit 1"
        ]
      interval: 20s
      timeout: 10s
      retries: 15
      start_period: 90s


  setup:
    image: docker.elastic.co/elasticsearch/elasticsearch:${STACK_VERSION}
    restart: "no"

    depends_on:
      elasticsearch:
        condition: service_healthy

    environment:
      ELASTIC_PASSWORD: ${ELASTIC_PASSWORD}
      KIBANA_PASSWORD: ${KIBANA_PASSWORD}

    command:
      - bash
      - -c
      - |
        echo "Setting the kibana_system password..."
        response="$$(curl -sS \
          -u "elastic:$${ELASTIC_PASSWORD}" \
          -H "Content-Type: application/json" \
          -X POST \
          http://elasticsearch:9200/_security/user/kibana_system/_password \
          -d "{\"password\":\"$${KIBANA_PASSWORD}\"}" \
          -w "%{http_code}" \
          -o /tmp/kibana-password-response)"

        if [ "$${response}" != "200" ]; then
          echo "Failed to set kibana_system password. HTTP status: $${response}"
          cat /tmp/kibana-password-response
          exit 1
        fi

        echo "kibana_system password configured successfully."

    networks:
      - pylon


  kibana:
    image: docker.elastic.co/kibana/kibana:${STACK_VERSION}
    restart: unless-stopped

    depends_on:
      setup:
        condition: service_completed_successfully

    environment:
      SERVER_NAME: pylon-kibana
      SERVER_PUBLICBASEURL: http://localhost:5601

      ELASTICSEARCH_HOSTS: http://elasticsearch:9200
      ELASTICSEARCH_USERNAME: kibana_system
      ELASTICSEARCH_PASSWORD: ${KIBANA_PASSWORD}

      XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY: ${KIBANA_ENCRYPTION_KEY}
      XPACK_REPORTING_ENCRYPTIONKEY: ${KIBANA_REPORTING_KEY}
      XPACK_SECURITY_ENCRYPTIONKEY: ${KIBANA_SECURITY_KEY}

    ports:
      - "${KB_PORT}:5601"

    networks:
      - pylon

    mem_limit: 3g

  fleet-server:
    image: docker.elastic.co/elastic-agent/elastic-agent:${STACK_VERSION}
    restart: unless-stopped

    depends_on:
      elasticsearch:
        condition: service_healthy
      kibana:
        condition: service_started

    environment:
      FLEET_SERVER_ENABLE: "1"
      FLEET_SERVER_ELASTICSEARCH_HOST: http://elasticsearch:9200
      FLEET_SERVER_SERVICE_TOKEN: ${FLEET_SERVER_SERVICE_TOKEN}
      FLEET_SERVER_POLICY_ID: ${FLEET_SERVER_POLICY_ID}

      FLEET_URL: "https://192.168.126.130:8220"
      FLEET_SERVER_HOST: 0.0.0.0
      FLEET_SERVER_PORT: "8220"

      FLEET_SERVER_CERT: /certs/pylon-fleet-server.crt
      FLEET_SERVER_CERT_KEY: /certs/pylon-fleet-server.key

    ports:
      - "192.168.126.130:8220:8220"

    volumes:
      - type: bind
        source: ./certs/fleet/server/pylon-fleet-server/pylon-fleet-server.crt
        target: /certs/pylon-fleet-server.crt
        read_only: true

      - type: bind
        source: ./certs/fleet/server/pylon-fleet-server/pylon-fleet-server.key
        target: /certs/pylon-fleet-server.key
        read_only: true

      - type: volume
        source: fleet-server-data
        target: /usr/share/elastic-agent/state

    networks:
      - pylon

    mem_limit: 2g

networks:
  pylon:
    name: pylon-cyberrange
    driver: bridge

volumes:
  fleet-server-data:
    name: pylon-fleet-server-data
